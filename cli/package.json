{
  "name": "openlabor",
  "version": "3.0.0",
  "description": "Browse, install, and pilot OpenLabor AI employees from Claude Code, Codex, Cursor, OpenCode, and more",
  "type": "module",
  "bin": {
    "openlabor": "./bin/openlabor.js",
    "ol": "./bin/openlabor.js",
    "openlabor-update-check": "./bin/openlabor-update-check",
    "openlabor-config": "./bin/openlabor-config"
  },
  "files": [
    "bin/",
    "lib/",
    "commands/",
    "catalog/",
    "VERSION",
    "registry.json",
    "CHANGELOG.md",
    "README.md"
  ],
  "scripts": {
    "gen:registry": "node scripts/generate-registry.js",
    "bundle:catalog": "node scripts/bundle-catalog.js",
    "prepack": "npm run gen:registry && npm run bundle:catalog"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenLabor/openlabor.git",
    "directory": "cli"
  },
  "homepage": "https://github.com/OpenLabor/openlabor#readme",
  "author": "OpenLabor",
  "bugs": {
    "url": "https://github.com/OpenLabor/openlabor/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "openlabor",
    "claude",
    "codex",
    "cursor",
    "opencode",
    "windsurf",
    "ai",
    "employees",
    "skills",
    "pilot",
    "dispatch",
    "ai-agents",
    "automation"
  ],
  "license": "MIT"
}
